rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin.
    // It checks for the existence of the user's UID in the admin_user collection.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admin_user/$(request.auth.uid));
    }

    // Rules for the admin_user collection.
    // Only the user themselves can manage their own document.
    match /admin_user/{adminId} {
      allow read, write: if request.auth.uid == adminId;
    }

    // Rules for the contact form submissions.
    match /contactFormSubmissions/{submissionId} {
      // Anyone can create a submission (i.e., submit the form).
      allow create: if true;
      // Only admins can read the submissions.
      allow read: if isAdmin();
      // No one can update or delete submissions from the client side.
      allow update, delete: if false;
    }

    // Rules for web banners.
    match /webBanners/{bannerId} {
      // Anyone (public users included) can read banner information.
      // The client-side query is responsible for filtering for active banners.
      allow get, list: if true;
      // Only admins can create, update, or delete banners.
      allow write: if isAdmin();
    }
    
    // Rules for mobile banners.
    match /mobileBanners/{bannerId} {
      // Anyone (public users included) can read banner information.
      // The client-side query is responsible for filtering for active banners.
      allow get, list: if true;
      // Only admins can create, update, or delete banners.
      allow write: if isAdmin();
    }
  }
}
