rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/admin_user/$(request.auth.uid));
    }

    // Rules for admin user profiles
    match /admin_user/{adminId} {
      // Admins can read their own profile, and other admins can see it
      allow read: if request.auth.uid == adminId || isAdmin();
      // Only the user can create their own profile document
      allow create: if request.auth.uid == adminId;
      // Admins can't delete other admin documents
      allow update, delete: if request.auth.uid == adminId;
    }

    // Rules for Contact Form Submissions
    match /contactFormSubmissions/{submissionId} {
      // Anyone can create a new submission
      allow create: if true;
      // Only admins can read submissions
      allow read: if isAdmin();
      // Nobody can update or delete submissions through the client
      allow update, delete: if false;
    }

    // Rules for both web and mobile banners
    match /webBanners/{bannerId} {
      // Public can read active, non-deleted banners
      allow get, list: if resource.data.status == true && resource.data.isDeleted == false;
      // Admins have full read/write access
      allow read, write: if isAdmin();
    }
    
    match /mobileBanners/{bannerId} {
      // Public can read active, non-deleted banners
      allow get, list: if resource.data.status == true && resource.data.isDeleted == false;
      // Admins have full read/write access
      allow read, write: if isAdmin();
    }
  }
}
