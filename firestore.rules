rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow admins to read submissions, and anyone to create them.
    match /contactFormSubmissions/{submissionId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/admin_user/$(request.auth.uid)).data.role == 'admin';
      allow create: if true;
      allow update, delete: if false;
    }

    // Rules for admin users
    match /admin_user/{adminId} {
      // Anyone can create an account during registration
      allow create: if true;

      // Only the authenticated owner of the document or another admin can read/update it.
      allow read, update, delete: if request.auth != null && (request.auth.uid == adminId || get(/databases/$(database)/documents/admin_user/$(request.auth.uid)).data.role == 'admin');
    }

    // Rules for banners
    match /banners/{bannerId} {
      // Admins can perform all actions
      allow read, create, update, delete: if request.auth != null && get(/databases/$(database)/documents/admin_user/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
