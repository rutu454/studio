rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check if the user is authenticated and has an admin role document.
      return request.auth != null && exists(/databases/$(database)/documents/admin_user/$(request.auth.uid));
    }

    match /contactFormSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /admin_user/{adminId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && (request.auth.uid == adminId || isAdmin());
    }

    match /webBanners/{bannerId} {
      // Public can list active, non-deleted banners.
      allow list: if request.auth == null && resource.data.status == true && resource.data.isDeleted == false;
      allow get: if resource.data.status == true && resource.data.isDeleted == false;
      
      // Admins can perform any action.
      allow read, write, delete: if isAdmin();
    }

    match /mobileBanners/{bannerId} {
      // Public can list active, non-deleted banners.
      allow list: if request.auth == null && resource.data.status == true && resource.data.isDeleted == false;
      allow get: if resource.data.status == true && resource.data.isDeleted == false;
      
      // Admins can perform any action.
      allow read, write, delete: if isAdmin();
    }
  }
}
