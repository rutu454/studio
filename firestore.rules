rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public creation of contact form submissions
    match /contactFormSubmissions/{submissionId} {
      allow read, update, delete: if false;
      allow create: if true;
    }
    
    // Allow authenticated users to manage banners and gallery
    match /webBanners/{bannerId} {
      allow read, write: if request.auth != null;
    }
    match /mobileBanners/{bannerId} {
      allow read, write: if request.auth != null;
    }
    match /galleryCategories/{categoryId} {
      allow read, write: if request.auth != null;
    }
    match /galleryItems/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
