rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public creation of contact form submissions
    match /contactFormSubmissions/{submissionId} {
      allow read, update, delete: if false;
      allow create: if true;
    }

    // Rules for admin users
    match /admin_user/{adminId} {
      // Anyone can create an account during registration
      allow create: if true;

      // Only the authenticated owner of the document or another admin can read/update it.
      allow read, update, delete: if request.auth != null && (request.auth.uid == adminId || get(/databases/$(database)/documents/admin_user/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
